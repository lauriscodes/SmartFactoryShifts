{
  "tabWidth": 4,
  "useTabs": true,
  "semi": true,
  "singleQuote": false,
  "quoteProps": "as-needed",
  "bracketSameLine": false,
  "arrowParens": "always",
  "trailingComma": "none",
  "vueIndentScriptAndStyle": true,
  "endOfLine": "auto",
  "printWidth": 120,
  "bracketSpacing": true,
  "overrides": [
    {
      "files": "*.html",
      "options": {
        "parser": "angular"
      }
    }
  ],
  "plugins": []
}
